  m_Script: {fileID: 11500000, guid: fb3f22d2da63c684bbd015a82d953e98, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSalleReunion
  voiceLines:
  - clip: {fileID: 8300000, guid: 018a76bb59077ba40a7fb64701cef330, type: 3}
    subtitle: 'TOI : Carl ? Carl t''es la ?'
    delayAfter: 0.5
  - clip: {fileID: 8300000, guid: 76a369fa742d2c04eaa79d08e70d81d1, type: 3}
    subtitle: 'Carl : Ouais...'
    delayAfter: 1
  - clip: {fileID: 8300000, guid: 06deac39f5df05744aa56627b62f1571, type: 3}
    subtitle: 'TOI : Putain qu''est-ce qu''il t''es arriver il c''est passer quoi
      ici ?'
    delayAfter: 1
  - clip: {fileID: 8300000, guid: 8c6a5502ab979984e8c7d9d91e40530f, type: 3}
    subtitle: "Carl : J'\xE9tait en train de r\xE9parer le vaisseau, j'ai entendu
      des bruits quand y'a eu la coupure de courant je suis aller voir en salle de
      r\xE9union, et la le monstre m'a saut\xE9 dessus, je sais pas si je vais tenir
      longtemps y'a plus personne qui est en vie dans le vaisseau... "
    delayAfter: 1
  - clip: {fileID: 8300000, guid: c9a3acd8a5534dd409bb9574fdc5711f, type: 3}
    subtitle: "TOI : Bouge pas je vais \xE0 l'infirmerie, je t'abandonnerai pas je
      vais pas te laisser je vais te sauver !"
    delayAfter: 0
  audioSource: {fileID: 780525671}
